# Optional paths; relative values are resolved against backend/.
# This file is an example, not automatically loaded. Set variables in your shell.
RECALLIQ_DATABASE_PATH=data/recalliq.sqlite3
RECALLIQ_UPLOADS_DIRECTORY=uploads
RECALLIQ_VECTOR_DIRECTORY=indexes/chroma
RECALLIQ_MODEL_CACHE=data/models
# Set to 1 after downloading the model to prohibit model-loader network access.
RECALLIQ_MODELS_OFFLINE=0
RECALLIQ_CHUNK_SIZE=800
RECALLIQ_CHUNK_OVERLAP=120
