# Optional paths; relative values are resolved against backend/.
# This file is an example, not automatically loaded. Set variables in your shell.
# Default is disabled: this milestone does not encrypt any files.
RECALLIQ_VAULT_MODE=disabled
# External mode requires a future trusted volume verifier; a folder cannot unlock it.
# In external mode, remove the five development private-path overrides below.
# RECALLIQ_VAULT_ROOT=V:\RecallIQ
RECALLIQ_DATABASE_PATH=data/recalliq.sqlite3
RECALLIQ_UPLOADS_DIRECTORY=uploads
RECALLIQ_VECTOR_DIRECTORY=indexes/chroma
RECALLIQ_TEMP_DIRECTORY=tmp/private
RECALLIQ_RECOVERY_DIRECTORY=data/recovery
RECALLIQ_MODEL_CACHE=data/models
# Set to 1 after downloading the model to prohibit model-loader network access.
RECALLIQ_MODELS_OFFLINE=0
RECALLIQ_CHUNK_SIZE=800
RECALLIQ_CHUNK_OVERLAP=120
# Candidate pool per retriever (1..200, at least the requested top_k is used).
RECALLIQ_SEARCH_CANDIDATES=50
